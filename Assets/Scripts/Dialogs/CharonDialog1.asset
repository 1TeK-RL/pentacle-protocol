  m_Name: CharonDialog1
  m_EditorClassIdentifier: 
  lines:
  - npcText: "Welcome, wandering user\u2026 to the threshold of the Infernet. I am
      Charon, ferryman of the forgotten files. I can bring you to the place you are
      seeking, here in in the Infernet. Like those uploaded before you, I expect
      you bring me a <color=#FFFF00>coin.dev</>. Do you have one ?"
    answers:
    - text: Yes.
      nextLineIndex: -1
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: No...
      nextLineIndex: -1
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  interlocutorName: Charon
