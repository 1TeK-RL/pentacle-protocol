  m_Script: {fileID: 11500000, guid: 8528a1847f61d1c438dc874d4aed6a16, type: 3}
  m_Name: CharonDialog1
  m_EditorClassIdentifier: 
  lines:
  - npcText: "Welcome, wandering user\u2026 to the threshold of the Infernet. I am
      Charon, ferryman of the forgotten files. I can bring you to the <color=#00bcff>The
      Penitentiary</color>. Like those uploaded before you, I expect you to bring
      me a <color=#FFFF00>coin.dev</color>. Do you have one ?"
    answers:
    - text: Yes.
      nextLineIndex: 4
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: No...
      nextLineIndex: 5
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - npcText: Lore
    answers: []
  - npcText: Lore
    answers: []
  - npcText: Lore
    answers: []
  - npcText: You know... I can see through the pathetic lines of code emulating your
      soul. Stop lying to me you bug ! Or I will drive you to <color=#ff2c2c>cerber.os</color>
      to be eaten alive !
    answers:
    - text: (Don't say anything)
      nextLineIndex: 5
      onSelected:
        m_PersistentCalls:
          m_Calls: []
    - text: Sorry...
      nextLineIndex: 5
      onSelected:
        m_PersistentCalls:
          m_Calls: []
  - npcText: Well I fear I can't drive you where you want... I can drop you by this
      <color=#00bcff>Hospital</color>.
    answers:
    - text: (Leave the car)
      nextLineIndex: -1
      onSelected:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 11400000}
            m_TargetAssemblyTypeName: DialogAsset, Assembly-CSharp
            m_MethodName: ChangeAmbianceSound
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
  interlocutorName: Charon
